{
    "name": "duncanmcclean/best-before",
    "description": "Give temporary classes and methods a best before date, then fail CI once they've gone off.",
    "license": "MIT",
    "authors": [
        {
            "name": "Duncan McClean",
            "email": "duncan@doublethree.digital"
        }
    ],
    "autoload": {
        "psr-4": {
            "DuncanMcClean\\BestBefore\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "bin": [
        "bin/best-before"
    ],
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.20",
        "phpunit/phpunit": "^11.5 || ^12.0"
    }
}
